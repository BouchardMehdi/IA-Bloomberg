COMPOSE_PROJECT_NAME=market-ai
POSTGRES_DB=market_ai
POSTGRES_USER=market_ai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://market_ai:change-me@postgres:5432/market_ai
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=/api/v1
LOG_LEVEL=INFO
ECB_COLLECTION_INTERVAL_MINUTES=15
FED_COLLECTION_INTERVAL_MINUTES=15
SEC_COLLECTION_INTERVAL_MINUTES=15
SEC_USER_AGENT=MarketAI/0.1 your-email@example.com
EVENT_EXTRACTION_INTERVAL_MINUTES=1
ENTITY_REGISTRY_ENABLED=true
ALPHA_VANTAGE_API_KEY=
MARKET_DAILY_REQUEST_BUDGET=20
EARNINGS_CALENDAR_ENABLED=true
COMPANY_PUBLICATIONS_ENABLED=true
FINANCIAL_RESULTS_ENABLED=true
WLS_IDENTITY_ENABLED=true
WLS_AUTO_WATCH_LIMIT=20
MARKET_MAX_PRICE_AGE_DAYS=7
MARKET_MAX_FX_AGE_DAYS=7
FX_COLLECTION_ENABLED=true
FX_COLLECTION_INTERVAL_MINUTES=60
DOCUMENT_COLLECTION_ENABLED=true
DOCUMENT_COLLECTION_INTERVAL_MINUTES=1
DOCUMENT_COLLECTION_BATCH_SIZE=5
DOCUMENT_MAX_BYTES=2000000
DOCUMENT_MAX_CHARS=60000
AI_ANALYSIS_ENABLED=false
# inline: installation locale ; remote: worker sur PC pour le VPS (voir docs/HYBRID_DEPLOYMENT.md).
AI_EXECUTION_MODE=inline
AI_REMOTE_WAIT_SECONDS=900
# Empreinte uniquement, jamais le jeton brut du PC.
AI_WORKER_TOKEN_SHA256=
AI_ANALYSIS_INTERVAL_MINUTES=5
AI_ANALYSIS_BATCH_SIZE=3
AI_PASSAGE_CHARS=3000
AI_MAX_PASSAGES=3
AI_INPUT_BUDGET_CHARS=9000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=600
SCHEDULER_RUN_ON_START=true

# Shared workspace; keep false for existing local use.
ENVIRONMENT=development
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
INTERNATIONAL_NEWS_ENABLED=true
ALERTS_ENABLED=true
# Optional authorized JSON exports; host folder private-data/imports mounts /imports.
DATA_INBOX_DIRECTORY=
# Encrypted backups (optional docker-compose.backup.yml). Public recipient only.
BACKUP_RECIPIENT=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
