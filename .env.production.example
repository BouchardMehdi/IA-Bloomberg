# Dedicated VPS configuration. Never reuse the local docker-compose.override.yml.
SITE_DOMAIN=market.example.com
ACME_EMAIL=you@example.com
POSTGRES_DB=market_ai
POSTGRES_USER=market_ai
# Hexadecimal random password; no URL-special characters.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
AI_WORKER_TOKEN_SHA256=REPLACE_WITH_SHA256_FROM_CONFIGURER
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=600
AI_REMOTE_WAIT_SECONDS=900
SEC_USER_AGENT=MarketAI/0.1 your-email@example.com
ALPHA_VANTAGE_API_KEY=
MARKET_DAILY_REQUEST_BUDGET=20
# Public age recipient only. Keep the private key OFF the VPS.
BACKUP_RECIPIENT=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
