{
    email {$ACME_EMAIL}
}
{$SITE_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 15MB
    }
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /docs* {
        respond 404
    }
    handle /openapi.json {
        respond 404
    }
    handle {
        reverse_proxy frontend:3000
    }
}
